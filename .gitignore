# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
pubspec.lock
# ...except the workspace root's, which is the only one that exists: `flutter pub get`
# at the root resolves all four packages together into this single lockfile, and a
# repository containing an application commits it so a build is reproducible.
!/pubspec.lock
*.iml
.idea/
.vscode/
.flutter-plugins
.flutter-plugins-dependencies

# Generated plugin registrants, regenerated by the tooling on every build
example/linux/flutter/generated_plugin_registrant.cc
example/linux/flutter/generated_plugin_registrant.h
example/linux/flutter/generated_plugins.cmake

# Native build output
compile_commands.json
/native-test-build/

# OS
.DS_Store
__pycache__/
*.pyc
